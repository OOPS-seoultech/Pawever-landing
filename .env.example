# 외부 분석 태그는 명시적으로 활성화한 경우에만 로드됩니다.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_DEBUG=false

# 운영 환경의 실제 ID는 .env 또는 배포 플랫폼 환경변수에만 설정하세요.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# GTM은 Hotjar 등 서드파티 태그를 코드 배포 없이 붙이기 위한 통로입니다.
# GA4는 코드에서 직접 보내므로 GTM 안에서 GA4 태그를 또 만들면 이중 집계됩니다.
# 자세한 내용은 docs/analytics-events.md 참고.
VITE_GTM_CONTAINER_ID=

# Cloudflare Pages 등 운영 배포에서는 AWS API origin을 지정합니다.
# 비워두면 로컬 Vite의 같은 출처 /api 프록시를 사용합니다.
VITE_API_BASE_URL=

# 로컬 Vite의 /api 요청을 Spring Boot로 전달합니다.
VITE_API_PROXY_TARGET=http://localhost:8080
